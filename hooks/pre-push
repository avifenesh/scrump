#!/bin/sh
# scrump pre-push hook: block a push if any blob added or changed by the
# pushed commits contains a secret, including a blob a later commit removed
# (it is still public in history). Fails closed when git or scrump cannot
# inspect the push.
#
# Install: save as .git/hooks/pre-push and chmod +x (or use core.hooksPath).
# Bypass a false positive once with: git push --no-verify
command -v scrump >/dev/null 2>&1 || {
  echo "pre-push: scrump not installed, skipping secret scan" >&2
  exit 0
}

zero=0000000000000000000000000000000000000000
tmp=$(mktemp -d) || {
  echo "pre-push: cannot create a temp dir; blocking push" >&2
  exit 1
}
trap 'rm -rf "$tmp"' EXIT
tab=$(printf '\t')
status=0
# $1 is the remote name git passed to the hook (a URL when pushing by URL).
remote_name=${1-}

fail() {
  echo "pre-push: $1; blocking push (use --no-verify to override)" >&2
  exit 1
}

# stdin: <local ref> SP <local sha> SP <remote ref> SP <remote sha>
# Git and scrump below read /dev/null so a later ref on stdin is not consumed.
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" != "$zero" ] &&
    git cat-file -e "$remote_sha^{commit}" >/dev/null 2>&1 </dev/null; then
    git rev-list "$remote_sha..$local_sha" >"$tmp/commits" </dev/null ||
      fail "cannot list commits $remote_sha..$local_sha"
  elif [ -n "$remote_name" ]; then
    # New ref, or a force push whose old tip is not in this clone.
    # Skip only history already on THIS remote. A secret that exists only
    # on some other remote is not public here yet.
    git rev-list "$local_sha" --not --remotes="$remote_name" >"$tmp/commits" </dev/null ||
      fail "cannot list commits for $local_sha"
  else
    git rev-list "$local_sha" >"$tmp/commits" </dev/null ||
      fail "cannot list commits for $local_sha"
  fi

  : >"$tmp/blobs"
  while read -r commit; do
    # diff.renames=false: never collapse a delete+add into status R.
    # --diff-filter=d keeps every non-deletion, including type changes (T)
    # and renames, whose new blob --diff-filter=AM would drop.
    # -m includes content introduced by a merge. Blob ids come from the raw
    # line, so a quoted path cannot hide the object.
    git -c diff.renames=false -c core.quotePath=false diff-tree \
      -r -m --root --no-commit-id --diff-filter=d "$commit" >"$tmp/raw" </dev/null ||
      fail "cannot diff $commit"
    # :<oldmode> <newmode> <oldsha> <newsha> <status>\t<path>
    # Skip gitlinks (mode 160000). Reject a line we cannot parse.
    awk -v t="$tab" '
      function bad() { exit 2 }
      function issha(s) {
        return (length(s) == 40 || length(s) == 64) && s ~ /^[0-9a-f]+$/
      }
      {
        if ($2 == "160000") next
        if (issha($4)) {
          if ($4 ~ /^0+$/) next
          n = split($0, p, t)
          if (n < 2 || p[2] == "") bad()
          path = p[2]
          for (i = 3; i <= n; i++) path = path t p[i]
          print $4 t path
          next
        }
        bad()
      }
    ' "$tmp/raw" >>"$tmp/blobs" || fail "cannot read the diff of $commit"
  done <"$tmp/commits"

  sort -t "$tab" -u -k1,1 "$tmp/blobs" -o "$tmp/blobs" ||
    fail "cannot collect blobs"

  while IFS="$tab" read -r blob path; do
    [ -n "$blob" ] || continue
    git cat-file blob "$blob" >"$tmp/blob" </dev/null ||
      fail "cannot read blob $blob ($path)"
    rc=0
    scrump scan "$tmp/blob" --profile text --fail-on-hit >"$tmp/out" 2>&1 </dev/null ||
      rc=$?
    case $rc in
      0) ;;
      3)
        echo "pre-push: possible secret in $path (blob $(printf '%.7s' "$blob"))" >&2
        sed -n 's/.*rule=\([^ ]*\).*/  rule: \1/p' "$tmp/out" | sort -u >&2
        status=1
        ;;
      *)
        fail "scrump failed (exit $rc) on $path: $(tail -n 1 "$tmp/out")"
        ;;
    esac
  done <"$tmp/blobs"
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: push blocked by scrump. Fix the file, or use --no-verify if it is a false positive." >&2
fi
exit "$status"
